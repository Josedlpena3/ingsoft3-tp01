# Copiar este archivo a ".env" y completar con valores propios antes de
# levantar el stack con "docker compose up --build". No versionar ".env".

# --- MongoDB ---
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=bezkoder_db

# --- Frontend ---
# Puerto del host donde se expone el frontend (nginx escucha en 80 adentro del contenedor)
FRONTEND_PORT=8081
